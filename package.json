{
  "name": "notify-flow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply notify-flow --local",
    "db:migrate:remote": "wrangler d1 migrations apply notify-flow --remote",
    "client:create": "node scripts/create-client.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.148.0"
  }
}
